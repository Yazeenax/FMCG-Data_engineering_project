{
  "datasets": [
    {
      "name": "fb973c62",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "version": "1.1",
        "source": "fmcg.gold.vw_fact_orders_enriched",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "synonyms": [
              "revenue",
              "sales"
            ],
            "name": "total_revenue",
            "expr": "SUM(`total_amount_inr`)",
            "comment": "Total order revenue in INR"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(`sold_quantity`)",
            "displayName": "Total Quantity Sold",
            "synonyms": [
              "quantity",
              "units sold"
            ]
          },
          {
            "name": "unique_customers",
            "expr": "COUNT(DISTINCT `customer_code`)",
            "displayName": "Unique Customers"
          },
          {
            "displayName": "Average Selling Price",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "synonyms": [
              "ASP",
              "price"
            ],
            "name": "avg_selling_price",
            "expr": "MEASURE(`total_revenue`) / MEASURE(`total_quantity`)",
            "comment": "Total revenue divided by total quantity sold, in INR"
          }
        ]
      }
    }
  ],
